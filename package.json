{
  "name": "lumen-studio",
  "productName": "Lumen Studio",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "author": {
    "name": "Lumen Studio"
  },
  "description": "Éditeur photo non destructif : calques façon Photoshop, colorimétrie façon Lightroom, moteur WebGL et LUTs.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:gen-types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "version:patch": "npm version patch",
    "lut:generate": "node scripts/generate-system-luts.mjs",
    "lut:validate": "node scripts/validate-luts.mjs",
    "desktop:icon": "node scripts/generate-icon.mjs",
    "desktop:dev": "next dev & node scripts/wait-for-server.mjs http://127.0.0.1:3000 && cross-env ELECTRON_DEV_URL=http://127.0.0.1:3000 electron .",
    "desktop:prepare": "next build && node scripts/prepare-desktop.mjs && node scripts/generate-icon.mjs",
    "desktop:dist": "npm run desktop:prepare && electron-builder",
    "desktop:dist:win": "npm run desktop:prepare && electron-builder --win --x64",
    "desktop:dist:linux": "npm run desktop:prepare && electron-builder --linux AppImage --x64",
    "desktop:dist:mac": "npm run desktop:prepare && electron-builder --mac",
    "release:check": "node scripts/check-release-env.mjs",
    "release": "npm run release:check && npm run version:patch && node scripts/release.mjs",
    "release:upload": "electron-builder --publish always --config.publish.owner=$LUMEN_GITHUB_OWNER --config.publish.repo=$LUMEN_GITHUB_REPO"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "fabric": "^6.5.4",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supabase": "^2.47.10",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "unrs-resolver@1.12.2": true
  }
}
