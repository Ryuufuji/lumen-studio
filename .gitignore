# dependencies
node_modules
.pnp
.pnp.js

# next.js
.next
out
next-env.d.ts

# electron-builder
# On ignore le CONTENU de build/ (artefacts de construction), pas le dossier
# lui-même : sinon l'exception ci-dessous serait sans effet. Git ne réinclut
# pas un fichier dont le dossier parent est exclu — il faut donc exclure
# `build/*` et non `build`.
build/*
# L'icône est une source, pas un artefact : sans elle, un clone frais ne peut
# pas reconstruire les installeurs.
!build/icon.png

# production
dist
release

# misc
.DS_Store
