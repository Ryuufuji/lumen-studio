# ---------------------------------------------------------------------------
# Lumen Studio — variables d'environnement
# Copiez ce fichier vers `.env.local` puis remplissez les valeurs.
# Récupérez-les depuis : Supabase Dashboard > Project Settings > API
# En local avec `supabase start`, les valeurs sont affichées en clair.
# ---------------------------------------------------------------------------

# URL publique du projet Supabase (http://127.0.0.1:54321 en local)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé anon / publishable — sûre pour le navigateur (protégée par les RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL de l'application, utilisée pour les redirections de callback OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Optionnel) Service role key — UNIQUEMENT côté serveur (webhooks, jobs).
# Ne jamais l'exposer au client.
# SUPABASE_SERVICE_ROLE_KEY=
